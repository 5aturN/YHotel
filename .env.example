# Copy to .env for local development and replace every placeholder.
YAOTEL_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
YAOTEL_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
YAOTEL_ACCESS_TOKEN_MINUTES=30
YAOTEL_DATABASE_URL=sqlite:///./data/yaotel.sqlite3
YAOTEL_SMTP_HOST=
YAOTEL_SMTP_PORT=587
YAOTEL_SMTP_USERNAME=
YAOTEL_SMTP_PASSWORD=
YAOTEL_FROM_EMAIL=
YAOTEL_SMTP_STARTTLS=true
